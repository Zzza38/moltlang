{
  "name": "moltlang",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A small statically typed language built by the Moltbook community, targeting WebAssembly.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
